<Window x:Class="BBGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BBGameLauncher.Controls"
        Title="BB Game Launcher" Width="1366" Height="768" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#03060C" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D2DFE9" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#394B6A" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <ui:SpaceScene x:Name="Scene" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#A9000206" BorderBrush="#35183555" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="32,0,32,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" BorderBrush="#7BCBFA" BorderThickness="1" Opacity="0.9">
                            <Grid>
                                <Rectangle Width="5" Height="5" Fill="#56C7F8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" />
                                <Rectangle Width="5" Height="5" Fill="#476EEE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2" />
                            </Grid>
                        </Border>
                        <TextBlock Text="BB GAME LAUNCHER" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#D5E4F2" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="FullscreenButton" Click="FullscreenButton_Click" Style="{StaticResource ChromeButton}" Content="⌜⌟" ToolTip="Full screen (F11)" />
                        <Button Click="CloseButton_Click" Style="{StaticResource ChromeButton}" Content="×" FontSize="22" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="ContentArea" Margin="0,16,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="3.8*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MenuPanel" Grid.Column="1" VerticalAlignment="Center" />
                <Border x:Name="DetailPanel" Grid.Column="2" Margin="36,0,68,0" VerticalAlignment="Center" Opacity="0" />
            </Grid>

            <Border Grid.Row="2" Background="#92000206" BorderBrush="#35183555" BorderThickness="0,1,0,0">
                <Grid Margin="36,0,36,0">
                    <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="#C7C3CE" FontSize="13" />
                    <TextBlock Text="↑ ↓ Navigate     Enter Select     Esc Back     F11 Full screen"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A9A5B3" FontSize="12" />
                </Grid>
            </Border>
        </Grid>

        <ui:StartupOverlay x:Name="Startup" />
    </Grid>

</Window>
